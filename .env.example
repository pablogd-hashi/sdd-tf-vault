# Copy to .env and fill in values. Never commit .env.

# Vault (set automatically by bootstrap; override if needed)
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=root

# Ticket provider: jira | linear (default used when not set per-request)
TICKET_PROVIDER=jira

# Jira (when TICKET_PROVIDER=jira)
JIRA_PROJECT_KEY=PE
JIRA_SITE=your-site.atlassian.net

# Linear (when TICKET_PROVIDER=linear)
LINEAR_TEAM_KEY=PE

# Slack (MCP notifications and queries)
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=
SLACK_DEFAULT_CHANNEL=#infra-onboarding

# GitHub
GITHUB_OWNER=your-github-username
GITHUB_REPO=sdd-tf-vault-cursor
GITHUB_PERSONAL_ACCESS_TOKEN=

# Kind cluster name
KIND_CLUSTER_NAME=pe-copilot
