# Copy to .env and fill in values. Never commit .env.

# Vault (set automatically by bootstrap; override if needed)
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=root

# Jira
JIRA_PROJECT_KEY=PE
JIRA_SITE=your-site.atlassian.net

# GitHub
GITHUB_OWNER=your-github-username
GITHUB_REPO=sdd-tf-vault-cursor
GITHUB_PERSONAL_ACCESS_TOKEN=

# Kind cluster name
KIND_CLUSTER_NAME=pe-copilot
